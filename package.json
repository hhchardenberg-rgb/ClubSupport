{
  "name": "clubsupport",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/migrate.ts && tsx scripts/bootstrap-admin.ts && tsx scripts/seed-demo.ts && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "test": "vitest run",
    "pitch": "vitest run -c vitest.pitch.config.ts && node scripts/pitch/build.mjs",
    "test:e2e": "next build && vitest run -c vitest.e2e.config.ts"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.7",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.3",
    "html5-qrcode": "^2.3.8",
    "next": "^16.3.8",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "resend": "^6.32.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.14.0",
    "drizzle-kit": "^0.31.11",
    "playwright-core": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
