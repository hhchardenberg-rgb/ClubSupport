# Kopieer naar .env.local. Zet NOOIT echte waarden in de repository.
DATABASE_URL=postgres://user:pass@host:5432/clubsupport   # Postgres (Neon/Vercel Marketplace)
APP_URL=http://localhost:3000                              # publieke basis-URL
BETTER_AUTH_SECRET=                                        # openssl rand -base64 32
TOKEN_HMAC_KEY=                                            # openssl rand -base64 32 (lookup-hash van pas-tokens)
TOKEN_ENC_KEY=                                             # openssl rand -base64 32 (AES-256-GCM, exact 32 bytes)
EMAIL_MODE=test                                            # test | live | disabled
RESEND_API_KEY=                                            # alleen server-side
EMAIL_FROM=HHC ClubSupport <onboarding@resend.dev>
EMAIL_TEST_RECIPIENT=                                      # in testmodus gaan ALLE mails hiernaartoe
CRON_SECRET=                                               # beschermt cron-endpoints
SCAN_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=730
DELETED_MEMBER_RETENTION_DAYS=90
REQUIRE_MFA_SCANNER=false
# Eerste systeembeheerder (eenmalig; verwijder na gebruik). Activatielink verschijnt in de buildlog.
BOOTSTRAP_ADMIN_EMAIL=
# Demo-/testaccounts met synthetische gegevens: true | reset | remove (zie scripts/seed-demo.ts). Niet gebruiken met echte leden.
SEED_DEMO=
# Hoe lang (dagen, 1-90) een lid zijn passen offline kan bekijken; kopie staat alleen op het eigen toestel
OFFLINE_PASS_MAX_DAYS=30
